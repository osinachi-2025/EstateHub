# Copy these values into .env for Cloudinary-backed property media uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Flask session signing key; use a long random value in production.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret

# Use the Render PostgreSQL internal URL in production. SQLite is suitable
# only for local development.
SQLALCHEMY_DATABASE_URI=sqlite:///properties.db

# SendGrid API delivery for password reset codes. SENDGRID_FROM must be a
# verified sender in your SendGrid account.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM=security@your-verified-sender.com
SENDGRID_API_URL=https://api.sendgrid.com/v3/mail/send

# Optional first-admin setup during application initialization.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FULL_NAME=Celtine Administrator
