# Copy these values into .env for Cloudinary-backed property media uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Flask session signing key; use a long random value in production.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret

# Use the Render PostgreSQL internal URL in production. SQLite is suitable
# only for local development.
SQLALCHEMY_DATABASE_URI=sqlite:///properties.db

# Gmail SMTP delivery for welcome and password reset emails. Use a Gmail App
# Password, and keep SMTP_USERNAME and SMTP_FROM on the same Gmail account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com

# Optional first-admin setup during application initialization.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FULL_NAME=Celtine Administrator
